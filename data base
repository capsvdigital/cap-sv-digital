// database.js - Conexión con Sheet.best
const API_URL = 'https://api.sheetbest.com/sheets/966e7004-81ba-454a-97fe-773822062d56';

// Guardar Pre-test
async function guardarPretest(datos) {
    try {
        const respuesta = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify([datos])
        });
        
        if (respuesta.ok) {
            console.log('✅ Pre-test guardado');
            return true;
        } else {
            console.error('Error:', await respuesta.text());
            return false;
        }
    } catch (error) {
        console.error('Error de conexión:', error);
        return false;
    }
}

// Guardar Post-test
async function guardarPosttest(datos) {
    try {
        const respuesta = await fetch(`${API_URL}/sheets/POSTTEST`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify([datos])
        });
        
        if (respuesta.ok) {
            console.log('✅ Post-test guardado');
            return true;
        } else {
            console.error('Error:', await respuesta.text());
            return false;
        }
    } catch (error) {
        console.error('Error de conexión:', error);
        return false;
    }
}

// Verificar si un código ya existe
async function verificarCodigo(codigo) {
    try {
        const respuesta = await fetch(`${API_URL}?Código=${encodeURIComponent(codigo)}`);
        const datos = await respuesta.json();
        return datos.length > 0;
    } catch (error) {
        console.error('Error al verificar:', error);
        return false;
    }
}

// Obtener datos de un participante
async function obtenerDatosParticipante(codigo) {
    try {
        const respuesta = await fetch(`${API_URL}?Código=${encodeURIComponent(codigo)}`);
        return await respuesta.json();
    } catch (error) {
        console.error('Error:', error);
        return [];
    }
}

// Calcular score de conocimientos (12 preguntas)
function calcularScoreConocimientos(respuestas) {
    const correctas = {
        C1: 'V', C2: 'V', C3: 'F', C4: 'F', C5: 'V',
        C6: 'V', C7: 'V', C8: 'V', C9: 'F', C10: 'F',
        C11: 'V', C12: 'F'
    };
    
    let score = 0;
    for (let i = 1; i <= 12; i++) {
        const respuesta = respuestas[`C${i}`];
        if (respuesta && respuesta.toUpperCase() === correctas[`C${i}`]) {
            score++;
        }
    }
    return score;
}

function obtenerNivel(score) {
    if (score >= 10) return 'Excelente';
    if (score >= 8) return 'Bueno';
    if (score >= 6) return 'Regular';
    return 'Necesita mejorar';
}
